# Copy to .env and adjust. Bun auto-loads .env from the repo root.

# --- Server ---
# Port the signaling backend listens on.
PORT=3000
# Public URL of this backend. Use real hostname when running behind cloudflared.
BASE_URL=https://golive.puhl.dev
# Used to sign/scope sessions. Change this in any non-local deployment.
SESSION_SECRET=dev-secret-change-me
# Set to "off" to disable per-IP rate limits (auth, room create, pairing).
# On by default; leave off only for local dev loops that trip the limits.
RATE_LIMITS=on

# --- Database (sessions, helper tokens, rooms) ---
# Local dev default: a golive.db is created under server/data/ (gitignored).
# Production (notebook): point at Turso and add the auth token:
#   DATABASE_URL=libsql://golive-<db>.turso.io
#   DATABASE_AUTH_TOKEN=eyJ...
DATABASE_URL=file:./data/golive.db
DATABASE_AUTH_TOKEN=
# Watch links stop working this many hours after the room is created.
ROOM_TTL_HOURS=24

# --- Discord OAuth (hosts only — viewers need no account) ---
# Create an app at https://discord.com/developers/applications
# Redirect URI: {BASE_URL}/auth/callback
# Leave both empty to enable dev-auth mode (instant login as "Dev User").
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- ICE servers handed to the browser for WebRTC ---
# Comma-separated STUN servers.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN (placeholder for later milestones; may be omitted for now).
# Comma-separated TURN URLs:
TURN_URLS=
# Shared TURN credentials (M0 only — real flow issues short-lived creds via the host credential API).
TURN_USERNAME=
TURN_CREDENTIAL=
